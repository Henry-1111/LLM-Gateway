PROVIDER_API_KEY=replace-with-provider-key
PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4.1-mini
PROVIDER_TIMEOUT_SECONDS=30
MAX_PROVIDER_ATTEMPTS=2
IDEMPOTENCY_TTL_SECONDS=86400
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
QUOTA_ENABLED=false
QUOTA_DEFAULT_TOKENS=1000000
QUOTA_DEFAULT_COMPLETION_RESERVE_TOKENS=1024
QUOTA_RESERVATION_TTL_SECONDS=300
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=llm_gateway.events
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRY_SECONDS=60
EVENT_CONSUMER_ENABLED=false
RABBITMQ_CONSUMER_QUEUE=llm_gateway.audit
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRIES=3
# When PROVIDERS is set, it replaces the singular PROVIDER_* configuration.
# PROVIDERS=[{"name":"openai","api_key":"sk-...","base_url":"https://api.openai.com/v1","models":["gpt-4.1-mini"],"priority":10,"enabled":true,"timeout_seconds":30},{"name":"backup","api_key":"...","base_url":"https://provider.example/v1","models":["gpt-4.1-mini","*"],"priority":20,"enabled":true,"timeout_seconds":30}]
DATABASE_URL=sqlite+aiosqlite:///./llm_gateway.db
DATABASE_AUTO_CREATE=false
