# Copy to .env before running Docker Compose. These defaults are for local development only.
POSTGRES_PASSWORD=change-postgres-password
RABBITMQ_PASSWORD=change-rabbitmq-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-grafana-password

# Configure a real OpenAI-compatible provider.
PROVIDER_API_KEY=replace-with-provider-key
PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4.1-mini

GATEWAY_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
