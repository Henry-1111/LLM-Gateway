# Public endpoint and ACME registration.
DOMAIN=gateway.example.com
ACME_EMAIL=ops@example.com
# Leave these at 80/443 in production. Overrides are useful for staging only.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Always deploy an immutable version tag or digest, never latest.
GATEWAY_IMAGE=ghcr.io/henry-1111/llm-gateway:0.1.0

# Infrastructure bootstrap credentials. Keep the real file chmod 600.
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-a-long-random-password
GRAFANA_ADMIN_USER=admin

# Gateway behavior.
PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4.1-mini
PROVIDER_TIMEOUT_SECONDS=30
MAX_PROVIDER_ATTEMPTS=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
QUOTA_ENABLED=true
QUOTA_DEFAULT_TOKENS=1000000
QUOTA_DEFAULT_COMPLETION_RESERVE_TOKENS=1024
QUOTA_RESERVATION_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
OUTBOX_PUBLISHER_ENABLED=true
EVENT_CONSUMER_ENABLED=true
PROMETHEUS_RETENTION=15d

# Paths are resolved from the repository directory by Docker Compose.
PROVIDER_API_KEY_FILE=./secrets/provider_api_key.txt
DATABASE_URL_FILE=./secrets/database_url.txt
REDIS_URL_FILE=./secrets/redis_url.txt
RABBITMQ_URL_FILE=./secrets/rabbitmq_url.txt
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password.txt
